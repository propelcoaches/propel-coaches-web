# Propel Coaches — Web Dashboard environment variables
# Copy to .env.local for local dev, and set the same keys in the Vercel
# dashboard (Project Settings > Environment Variables) for production.
# NEXT_PUBLIC_* values are exposed to the browser — never put secrets there.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose

# --- Site URLs (required) ---
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app  # no trailing slash
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- AI (required for AI features) ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- Stripe (required for billing) ---
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...                   # from the Stripe webhook endpoint

# Stripe price IDs (per plan/tier)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ELITE=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_CLINIC=
STRIPE_PRICE_COACH_STARTER=
STRIPE_PRICE_COACH_PRO=
STRIPE_PRICE_COACH_SCALE=
STRIPE_PRICE_AI_STARTER=
STRIPE_PRICE_AI_PRO=
STRIPE_PRICE_AI_ELITE=

# --- Email (Resend) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# --- Secrets / webhook protection ---
CRON_SECRET=                                       # openssl rand -hex 32 — protects Vercel cron routes
AI_WEBHOOK_SECRET=                                 # openssl rand -hex 32 — Supabase message webhook
WEBHOOK_SECRET=                                    # openssl rand -hex 32 — generic webhook auth
ADMIN_SECRET=                                       # protects admin/stripe overview API routes
ADMIN_USER_IDS=                                     # comma-separated Supabase user UUIDs with admin access
NEXT_PUBLIC_ADMIN_PIN=                              # NOTE: public — used for a client-side admin gate only

# --- Media ---
PEXELS_API_KEY=                                     # stock image search (optional)
